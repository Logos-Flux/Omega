{
  "name": "@omega-inc/app-shell",
  "version": "0.1.0",
  "description": "Minimal layout shell + auth stubs for Omega frontends. The OSS build doesn't ship app-level auth — operators wrap the app with their own reverse-proxy auth (oauth2-proxy, Caddy basic auth, etc.).",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.12.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "license": "Apache-2.0"
}
