{
  "name": "rag-api",
  "version": "0.1.0",
  "description": "Omega RAG wrapper API. Bearer-token multi-tenant front for RAGFlow.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
