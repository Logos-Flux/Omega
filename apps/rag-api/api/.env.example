PORT=3100
NODE_ENV=development

# Postgres for the rag.* schema. Local docker compose default below.
DATABASE_URL=postgresql://omega:omega@localhost:5432/omega

# RAGFlow API base. Run RAGFlow upstream from infiniflow/ragflow on a beefy
# host (16 GB RAM minimum — MinIO + ES + MySQL + Redis stack); point this
# URL at it. Reachable via tailnet or direct IP, your call.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=

# Optional: pin a specific RAGFlow dataset ID. If unset and exactly one
# dataset is present, the wrapper adopts it on first use.
RAGFLOW_DATASET_ID=

# Bootstrap admin token used by src/lib/seed.ts to ensure a default api_keys
# row exists. Keep secret. Generate with `openssl rand -hex 32`.
ADMIN_BEARER_TOKEN=

# Local-dev bypass: a constant-time comparison against this value resolves to
# the default tenant without an api_keys lookup. Use only in dev.
DEV_BEARER_TOKEN=

# --- Google Drive OAuth strategy ---
# How the ingest worker mints per-user Google access tokens.
#   env        — exchange a static refresh token from env (single-user dev path)
#   controller — POST controller/api/oauth/google/access-token (multi-user prod)
OAUTH_PROVIDER=env

# Used by OAUTH_PROVIDER=env. The user_id this refresh token belongs to.
OAUTH_FALLBACK_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Used by OAUTH_PROVIDER=controller. Same value as the controller's
# CONTROLLER_SERVICE_TOKEN env var.
CONTROLLER_BASE_URL=
CONTROLLER_SERVICE_TOKEN=

# --- Source mode (v0.6.0+) ---
# Mirrors the rag-ingest worker's RAG_SOURCE. Read here so the
# /api/v1/users/:id/status route knows whether to include filesystem_*
# fields in the response. Must match the worker's value.
RAG_SOURCE=drive
