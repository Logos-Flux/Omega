NODE_ENV=development

DATABASE_URL=postgresql://rag:PASS@metadata-db:5432/rag

# RAGFlow upload target — same value as the wrapper API uses.
RAGFLOW_BASE_URL=http://docker-ragflow-cpu-1:9380
RAGFLOW_API_KEY=

# Background re-crawl cadence (seconds). Each user is enqueued for
# re-crawl when last_synced_at is older than this.
DEFAULT_POLL_INTERVAL=900

# OAuth — same shape as the API. Worker mints access tokens using the
# user's chat_user_id (which is what the controller's mint endpoint
# will key on once Phase 3.2 lands).
OAUTH_PROVIDER=env
OAUTH_FALLBACK_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
CONTROLLER_BASE_URL=
CONTROLLER_SERVICE_TOKEN=

# ─── Crawl scope (v0.3.0+) ────────────────────────────────────────────────
# The worker crawls up to two roots per user, in this order:
#
#   1. The user's personal folder. Resolved by name in the user's own
#      Drive on first sync and cached on rag.users.gdrive_my_ai_folder_id.
#      Default name: 'my-ai'. Override here for org-specific naming.
RAG_PERSONAL_FOLDER_NAME=my-ai
#
#   2. A shared "Knowledge Base" folder ID — same value for every user.
#      Per-user OAuth permissions filter what each user actually sees
#      inside it; the same folder ID is fine even with mixed-permission
#      users. Leave unset to skip the shared root.
RAG_KNOWLEDGE_BASE_FOLDER_ID=

# DEPRECATED: comma-separated Drive folder IDs. Was the v0.2.x scope
# control; replaced by the personal folder + shared knowledge-base pair
# above. The worker still respects this env for one release as a
# fallback, but logs a deprecation warning. Will be removed in the next
# minor version.
RAG_FOLDER_ALLOWLIST=
