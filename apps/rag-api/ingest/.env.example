NODE_ENV=development

DATABASE_URL=postgresql://rag:PASS@metadata-db:5432/rag

# RAGFlow upload target — same value as the wrapper API uses.
RAGFLOW_BASE_URL=http://docker-ragflow-cpu-1:9380
RAGFLOW_API_KEY=

# Background re-crawl cadence (seconds). Each user is enqueued for
# re-crawl when last_synced_at is older than this.
DEFAULT_POLL_INTERVAL=900

# OAuth — same shape as the API. Worker mints access tokens using the
# user's chat_user_id (which is what the controller's mint endpoint
# will key on once Phase 3.2 lands).
OAUTH_PROVIDER=env
OAUTH_FALLBACK_USER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
CONTROLLER_BASE_URL=
CONTROLLER_SERVICE_TOKEN=

# Comma-separated Drive folder/shared-drive IDs to scope ingestion to.
# Worker walks these folders recursively; subfolders included; files
# outside the allowlist are ignored even if the user can see them.
# Empty/unset → whole-drive walk (every file the user has access to).
RAG_FOLDER_ALLOWLIST=
