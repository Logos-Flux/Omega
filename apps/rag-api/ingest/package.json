{
  "name": "rag-ingest",
  "version": "0.1.0",
  "description": "GDrive → RAGFlow sync worker.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "googleapis": "^172.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
