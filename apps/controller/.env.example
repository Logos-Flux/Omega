PORT=3001
# Default to production. Override locally with NODE_ENV=development for dev-only behaviors.
NODE_ENV=production

# CSV of origins allowed to send credentialed CORS requests. Required in
# production; in dev, leaving this unset falls back to
# http://localhost:5175,http://localhost:3000.
ALLOWED_ORIGINS=

# Postgres — same database as chat-api. Controller uses its own `pi` schema;
# the `chat.users` table is read-write so identity stays consistent across
# services.
DATABASE_URL=postgresql://omega:omega@localhost:5432/omega

# Session middleware (src/middleware/session.ts) runs in one of two modes:
#
#   - Single-user stub (default): every request maps to DEFAULT_USER_EMAIL.
#     Operators provide their own perimeter auth (oauth2-proxy, Caddy basic
#     auth, Tailscale serve, etc.) and the controller trusts whoever can
#     reach it.
#   - Cloudflare Access: when CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD are
#     both set, the controller verifies the CF Access JWT
#     (Cf-Access-Jwt-Assertion header or CF_Authorization cookie) against
#     the team's public JWKS and uses the verified `email` and `sub` claims
#     as the user identity. Required for any multi-tenant deploy.
#
# DEFAULT_USER_EMAIL is ignored when CF Access is configured. Setting only
# one of the two CF Access vars is a misconfiguration and the process will
# fail to start.
DEFAULT_USER_EMAIL=local@localhost
# CF_ACCESS_TEAM_DOMAIN=acme           # or https://acme.cloudflareaccess.com
# CF_ACCESS_AUD=<app-aud-from-dashboard>

# Compute provider for the per-user pi-harness sandbox.
#   docker  — local Docker daemon (default). Single-machine deploys.
#   sprites — Fly Sprites. Set SPRITES_API_TOKEN.
COMPUTE_PROVIDER=docker

# DockerProvider config (used when COMPUTE_PROVIDER=docker).
HARNESS_IMAGE=omega-pi-harness:local
DOCKER_SOCKET=/var/run/docker.sock
# When set, attach harness containers to this docker network so the controller
# can reach them by container name (e.g. omega_default in compose).
HARNESS_NETWORK=
# URL base the browser uses to reach the harness. The provider appends
# `:<published-port>`. Leave as `http://localhost` for single-machine deploys.
HARNESS_HOST_URL_BASE=http://localhost
# Verbatim URL handed to the browser, replacing `${HARNESS_HOST_URL_BASE}:<port>`.
# Use when the harness sits behind a TLS reverse proxy on a path (no port in
# the public URL). Pair with HARNESS_HOST_PORT so the proxy upstream is
# predictable. Only one concurrent session works in this mode.
# HARNESS_PUBLIC_URL=https://omega.example.com/harness
# Per-session browser routing (recommended for any remote/HTTPS deploy). Set to
# the public origin; the browser then reaches each user's harness via
# `<base>/harness/<container>`, which Caddy reverse-proxies (WS-aware) to that
# container on the shared docker network. Unlike HARNESS_PUBLIC_URL this scales
# to many concurrent users. Leave empty for pure local-laptop dev (browser hits
# http://localhost:<port>). Takes precedence over HARNESS_PUBLIC_URL.
# HARNESS_BROWSER_URL_BASE=https://omega.example.com
# Fixed host port for the harness's 8080/tcp binding. Default: random. Set this
# when fronting the harness with a reverse proxy that expects a known upstream.
# HARNESS_HOST_PORT=7100

# SpritesProvider config (used when COMPUTE_PROVIDER=sprites).
# SPRITES_API_TOKEN=
# SPRITES_URL_AUTH=sprite

# HS256 secret shared with pi-harness. Used to sign session JWTs minted by
# /api/session/start (and the OAuth `state` param when ENABLE_GOOGLE_OAUTH=true).
# Generate with `openssl rand -hex 32`.
HARNESS_JWT_SECRET=

# AES-256-GCM key for encrypting pi.oauth_tokens.refresh_token at rest.
# Required when ENABLE_GOOGLE_OAUTH=true. Generate with `openssl rand -hex 32`.
OAUTH_TOKEN_ENC_KEY=

# Service-to-service bearer token for /api/oauth/google/access-token.
# Generate with `openssl rand -hex 32`. Distribute the same value to
# every consumer (rag-api, pi-harness gccli shim, etc.).
CONTROLLER_SERVICE_TOKEN=

# Admin bearer token for /api/admin/* (operator break-glass routes).
ADMIN_BEARER_TOKEN=

# --- Google OAuth (optional, opt-in) ----------------------------------------
# Set ENABLE_GOOGLE_OAUTH=true to enable /api/oauth/google/{start,callback,
# status,access-token}. Disabled by default since most operators won't need
# Drive/Calendar integration on day one.
ENABLE_GOOGLE_OAUTH=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional override; defaults to http://localhost:3001/api/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# CSV of hostnames the OAuth flow is allowed to redirect back to after the
# Google consent screen. Each entry must be a bare hostname (no scheme, no
# path). https:// is required at the call site. Example:
#   ALLOWED_RETURN_HOSTS=chat.example.com,example.com
# If unset, only localhost / 127.0.0.1 (in dev mode) is accepted — no public
# hosts at all. Set this when ENABLE_GOOGLE_OAUTH=true in any non-dev deploy.
ALLOWED_RETURN_HOSTS=

# Where the callback's "Try again" button points when the flow fails BEFORE we
# can recover a trusted return_to from the (failed/expired) state — i.e. the
# state-expired and Google-denied error pages. Should be the app URL that hosts
# the Google connect entry point (re-landing there re-triggers the reconnect
# modal). Falls back to https://<first ALLOWED_RETURN_HOSTS entry>/ when unset.
#   OAUTH_RETRY_URL=https://chat.example.com/chat/
OAUTH_RETRY_URL=

# --- RAG service (optional) -------------------------------------------------
# Point at a running rag-api deployment to enable Drive-backed retrieval.
# Both vars must be set together; setting only one disables the feature
# (with a warning). When enabled, the controller exposes /api/rag/* proxy
# routes (PR 7) and the pi-harness rag.search skill registers (PR 6).
#
#   RAG_API_URL       — base URL of the rag-api wrapper, no trailing slash
#                       (e.g. https://rag.example.com or http://rag-api:3100)
#   RAG_SERVICE_TOKEN — bearer token issued by rag-api; matches one of its
#                       rag.api_keys entries
RAG_API_URL=
RAG_SERVICE_TOKEN=

# --- RAG source mode (v0.6.0+) ----------------------------------------------
# Picks which ingest source the rag-ingest worker uses. The controller reads
# this only to surface mode + features at GET /api/rag/source so the chat
# frontend can pick a state machine.
#
# IMPORTANT: this value MUST match the RAG_SOURCE set on the rag-ingest
# container. Mismatched values produce confusing UI states (frontend renders
# the wrong pane while the worker crawls the other source).
#
#   drive       — per-user Drive crawl (default; preserves v0.5.x behaviour)
#   filesystem  — walks RAG_FILES_DIR on the worker; OAuth UX is hidden on
#                 the frontend regardless of ENABLE_GOOGLE_OAUTH
RAG_SOURCE=drive

# Optional: in drive mode, the chat frontend renders a "shared knowledge
# base" badge when this is set. The actual folder id is read by the
# rag-ingest worker, not the controller — declare it on both sides.
RAG_KNOWLEDGE_BASE_FOLDER_ID=
