# Vite dev server proxy targets. Both default to localhost when unset; only
# override if chat-api or controller is running somewhere other than the
# expected port on the same host.
VITE_API_URL=http://localhost:3000
VITE_CONTROLLER_URL=http://localhost:3001

# --- Brand identity (build-time) ---------------------------------------------
# Vite inlines these into the bundle at build time. Changing them requires
# a frontend rebuild, not a runtime config swap. Empty / unset falls back
# to the OSS defaults shown.
#
#   VITE_BRAND_NAME  — wordmark text in the top nav, page title, and
#                      empty-state badge. Default: "Omega".
#   VITE_BRAND_GLYPH — single-character mark used as the assistant
#                      avatar and inside the agent-mode banner.
#                      Default: "Ω".
VITE_BRAND_NAME=Omega
VITE_BRAND_GLYPH=Ω

# --- Deploy plumbing (build-time) --------------------------------------------
# These let a deploy mount the SPA under a sub-path, point auth at a
# different origin, wire Cloudflare Access logout, and (in dev) skip the
# /api/me probe. All optional — leave unset for the OSS defaults.
#
#   VITE_BASE_PATH               — Vite `base` (SPA mount path). Use
#                                  `/chat/` to serve the SPA at
#                                  `https://example.com/chat/`. Trailing
#                                  slash required. Default: "/".
#   VITE_API_BASE                — URL prefix for /api/me (used by
#                                  AuthProvider). Empty string forces
#                                  same-origin no-prefix even when
#                                  VITE_BASE_PATH is non-root. Unset
#                                  falls back to the SPA mount path.
#   VITE_CF_ACCESS_TEAM_DOMAIN   — Cloudflare Access team domain (e.g.
#                                  https://example.cloudflareaccess.com).
#                                  Used by signOut() to clear the CF
#                                  session.
#   VITE_DEV_FAKE_USER           — JSON-encoded SessionUser; if set,
#                                  AuthProvider skips /api/me and
#                                  authenticates as this user. Honored
#                                  ONLY in dev builds (`bun run dev` /
#                                  import.meta.env.DEV). Production
#                                  builds ignore it.
# Example dev-only fake user:
# VITE_DEV_FAKE_USER='{"id":"dev","email":"dev@local","name":"Dev","picture":null,"sub":"dev"}'
# VITE_BASE_PATH=/chat/
# VITE_API_BASE=
# VITE_CF_ACCESS_TEAM_DOMAIN=https://example.cloudflareaccess.com
