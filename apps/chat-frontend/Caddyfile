# Caddy serves the built SPA on :8080. The two backend routes are read
# from env vars so the same image works in compose and on Fly:
#   CHAT_API_UPSTREAM     — defaults to http://chat-api:3000
#   CONTROLLER_UPSTREAM   — defaults to http://controller:3001
#
# Frontend code uses relative URLs:
#   /api/*               → chat-api
#   /api/controller/*    → controller (rewritten to /api/* upstream)

:8080 {
	encode gzip

	# Controller proxy — must come before /api/* below.
	handle /api/controller/* {
		uri strip_prefix /api/controller
		reverse_proxy {$CONTROLLER_UPSTREAM:http://controller:3001} {
			header_up Host {upstream_hostport}
		}
	}

	# chat-api proxy.
	handle /api/* {
		reverse_proxy {$CHAT_API_UPSTREAM:http://chat-api:3000} {
			header_up Host {upstream_hostport}
		}
	}

	# Agent-mode harness (sprite) proxy — the browser-facing half of the
	# per-session sprite-URL split. The controller hands the browser
	# https://<host>/harness/<container>, and we reverse-proxy (WS-aware) to
	# that harness container on the shared docker network. Without this the
	# browser would get http://localhost:<dynamic-port>, unreachable over
	# remote HTTPS. The name is constrained to `harness-<slug>` so a client
	# can't address arbitrary containers. reverse_proxy upgrades WebSockets
	# automatically; {re.h.2} carries the remainder path (e.g. /ws).
	@harness path_regexp h ^/harness/(harness-[a-z0-9]+)(/.*)?$
	handle @harness {
		rewrite * {re.h.2}
		reverse_proxy {re.h.1}:8080
	}

	# Static SPA + fallback.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server

		# PERF-15 — immutable ONLY for Vite's content-hashed /assets/*. The old
		# extension matcher stuck every .js/.css/.ico — including non-hashed
		# public/ files like favicon — with a 1-year immutable cache so they
		# could never be busted. Those now revalidate normally; no-cache the index.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
	}

	handle /healthz {
		respond "ok" 200
	}
}
