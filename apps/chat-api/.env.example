PORT=3000
# Default to production. Override locally with NODE_ENV=development for dev-only behaviors.
NODE_ENV=production

# CSV of origins allowed to send credentialed CORS requests. Required in
# production; in dev, leaving this unset falls back to
# http://localhost:5175,http://localhost:3000.
ALLOWED_ORIGINS=

# Postgres connection. Docker compose default: postgres://omega:omega@postgres:5432/omega
DATABASE_URL=postgresql://omega:omega@localhost:5432/omega

# Single-user identity used by src/middleware/session.ts. Multi-user deploys
# replace that file with their own auth verifier (see git history pre-OSS for
# the JWKS-verifying example we used in production).
DEFAULT_USER_EMAIL=local@localhost

# LLM provider API keys.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
