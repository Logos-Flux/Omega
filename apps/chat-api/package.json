{
  "name": "chat-api",
  "version": "0.1.0",
  "description": "Omega chat API. Scaffold only — to be scoped.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.1",
    "@ai-sdk/google": "^4.0.2",
    "@ai-sdk/perplexity": "^4.0.1",
    "@hono/node-server": "^2.1.0",
    "ai": "^7.0.4",
    "hono": "^4.13.1",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
