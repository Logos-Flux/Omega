{
  "name": "chat-api",
  "version": "0.1.0",
  "description": "Omega chat API. Scaffold only — to be scoped.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/perplexity": "^3.0.30",
    "@hono/node-server": "^2.0.1",
    "ai": "^6.0.168",
    "hono": "^4.12.15",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
