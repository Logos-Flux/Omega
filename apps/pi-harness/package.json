{
  "name": "pi-harness",
  "version": "0.1.0",
  "description": "Omega Pi harness — long-running Bun service that lives inside a per-user Sprite environment.",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:update": "UPDATE_SNAPSHOTS=1 bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.1",
    "@ai-sdk/google": "^4.0.2",
    "@ai-sdk/perplexity": "^4.0.1",
    "@ai-sdk/provider-utils": "^5.0.1",
    "ai": "^7.0.4",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
