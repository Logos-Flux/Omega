PORT=8080

# Persistent storage root. /workspace inside a container; ./workspace locally.
WORKSPACE_ROOT=/workspace

# LLM provider API keys. The controller injects these into per-user containers
# via the DockerProvider env config (or via Sprites env when using Sprites).
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# Default model. Overridable per-message via the WS protocol.
DEFAULT_PROVIDER=anthropic
DEFAULT_MODEL=claude-opus-4-7

# HS256 secret. The controller signs session JWTs with this; the harness
# verifies them on every WS upgrade and HTTP request. Same value as the
# controller's HARNESS_JWT_SECRET.
HARNESS_JWT_SECRET=

# --- gccli/gdcli/gmcli boot shim (optional, gated by ENABLE_GOOGLE_OAUTH) ---
# When the controller has ENABLE_GOOGLE_OAUTH=true, the harness can pull a
# fresh Google access token from the controller and pre-populate
# ~/.gccli/, ~/.gdcli/, ~/.gmcli/ accounts.json. Both vars must be set
# together; if either is missing the shim is silently disabled.
CONTROLLER_BASE_URL=
CONTROLLER_SERVICE_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- rag_search tool (optional) -----------------------------------------------
# Point at a running rag-api deployment to expose the `rag_search` tool to
# the model. Both vars must be set together; setting only one disables the
# tool with a one-shot warning. Same pair as on the controller — typically
# the controller injects these into the harness env via spawn config so
# operators set them once.
RAG_API_URL=
RAG_SERVICE_TOKEN=
