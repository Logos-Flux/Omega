node_modules/
**/node_modules/
dist/
**/dist/
.DS_Store
*.log
.env
.env.local
.env.production
*.tsbuildinfo
deploy/.env

# Editor/agent local state
.claude/
.idea/
.vscode/

# Internal release-process docs (not part of the public release)
RELEASE_CHECKLIST.md
RELEASE_CHECKLIST_OMEGA.md

# Internal planning / handoff docs (private; not part of the public release)
dev-docs/

# Operator-published goldens. Only the example/ subdirectory is shipped
# in OSS; real golden manifests live in their operator's deploy repo.
# See apps/controller/goldens/README.md.
apps/controller/goldens/*/
!apps/controller/goldens/example/

# Operator-specific chat-frontend Caddyfiles. The OSS Caddyfile in this
# directory is the dev/local default; operators copy their own variant
# (e.g. Caddyfile.prod, Caddyfile.staging) into the tree at deploy time so
# the apps/chat-frontend/Dockerfile can COPY it into the image. The
# canonical home for these is the operator's deploy repo.
apps/chat-frontend/Caddyfile.local*
apps/chat-frontend/Caddyfile.prod*
apps/chat-frontend/Caddyfile.staging*

# Local Hermes agent scratch (plans, transcripts)
.hermes/
